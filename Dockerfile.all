# Stage 1: Build Frontend
FROM docker.m.daocloud.io/node:22 AS frontend-builder
WORKDIR /web

# Set npm registry for faster installation in China
RUN npm config set registry https://registry.npmmirror.com

# Copy package files first for caching
COPY flowgram/package.json flowgram/package-lock.json ./
RUN npm install

# Copy source and build
COPY flowgram/ .
RUN npm run build:prod

# Stage 2: Build Backend
FROM docker.m.daocloud.io/golang:1.24 AS backend-builder

COPY . /src
WORKDIR /src

# Build the Go application
RUN GOPROXY=https://goproxy.cn make build

# Stage 3: Feishu / Lark CLI (@larksuite/cli, npm global)
# 使用与 frontend-builder 相同的 node:22，便于复用镜像层并避免单独拉 node:*-slim 时偶发的镜像站 EOF
FROM docker.m.daocloud.io/node:22 AS lark-cli-installer
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*
RUN npm config set registry https://registry.npmmirror.com \
    && npm install -g @larksuite/cli \
    && npx --yes skills add larksuite/cli -y -g

# Stage 4: Final Image
FROM docker.m.daocloud.io/debian:stable-slim

# Replace sources with Aliyun mirror for speed in China
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

# Install Nginx, Cursor Agent CLI deps, and basic dependencies
# build-essential + python3-dev：uv/pip 安装含 C 扩展的包时必需（如 pycryptodome←volcengine←MCP TLS 等）
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tar \
    netbase \
    nginx \
    python3 \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/ \
    && apt-get autoremove -y && apt-get autoclean -y

# Cursor Agent CLI (~/.local/bin); Feishu CLI needs Node from /usr/local
ENV PATH="/root/.local/bin:/usr/local/bin:${PATH}"

# uv: Python 包/项目管理器（https://github.com/astral-sh/uv），安装到 ~/.local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN curl -fsSL https://cursor.com/install | bash

# 本机 ~/.cursor → 构建前执行: bash scripts/prepare-docker-cursor.sh（写入 deploy/docker-cursor-overlay/.cursor）
COPY deploy/docker-cursor-overlay/.cursor /root/.cursor/

# Feishu CLI: copy Node runtime + global npm modules from lark-cli-installer
COPY --from=lark-cli-installer /usr/local /usr/local

WORKDIR /app

# Copy backend binary
COPY --from=backend-builder /src/bin/server /app/server
# Copy default skills directory for Agent runtime
COPY --from=backend-builder /src/skills /app/skills
COPY --from=backend-builder /src/mcp /app/mcp

# Copy frontend static files to a dedicated directory
COPY --from=frontend-builder /web/dist /app/dist

# Configure Nginx：静态 + /api/ 反代；交互式终端 WebSocket 单独 location（Upgrade + 长超时）
COPY deploy/nginx-app.conf /etc/nginx/sites-enabled/default

# Backend + Nginx（勿用 echo 拼 \\n：在单引号里不是换行，会导致脚本无效、后端未起 → Nginx 502）
COPY scripts/docker-workflow-start.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8081
EXPOSE 8000
EXPOSE 9000
VOLUME /data/conf

CMD ["/bin/bash", "/app/start.sh"]
