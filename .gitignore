# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
agent_workspace/
*.cert
*.key
*.log
bin/

# Develop tools
.vscode/
.idea/
*.swp
volumes/
.worktrees/

# Docker 构建时从本机 rsync 的 Cursor 目录（勿提交密钥）
deploy/docker-cursor-overlay/.cursor/*
!deploy/docker-cursor-overlay/.cursor/.gitkeep

# Cursor Superpowers 插件本地会话状态（进程、日志等）
.superpowers/**/state/